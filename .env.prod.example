# Copy to .env.prod on the server and fill in. Never commit the filled version.
#
#   cp .env.prod.example .env.prod
#   nano .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# docker-compose.prod.yml deliberately has no fallback values for anything in
# this file. A missing secret stops the stack rather than starting it in a state
# that half works — which is much harder to diagnose than a refusal to boot.

# --- Database -----------------------------------------------------------------
# This is a new database on a new server. Generate a fresh password; do not reuse
# the development one, which is in git.
DB_NAME=cleveft
DB_USERNAME=cleveft_user
DB_PASSWORD=

# --- JWT ----------------------------------------------------------------------
# At least 32 bytes. The gateway and auth service must agree exactly, and both
# read this one value.
#
#   openssl rand -base64 48
JWT_SECRET=

# --- Google / Gemini ----------------------------------------------------------
# The rotated key.
GOOGLE_API_KEY=

# --- Mail ---------------------------------------------------------------------
# The rotated Gmail app password, with no spaces.
#
# Port 465 and smtps, because 587 is blocked on some networks and 465 is the one
# that worked from the laptop. If mail fails on the server, try 587 with
# MAIL_PORT=587, MAIL_SSL=false, MAIL_STARTTLS=true, MAIL_PROTOCOL=smtp.
MAIL_USERNAME=cleveft101@gmail.com
MAIL_PASSWORD=
MAIL_FROM=Cleveft <cleveft101@gmail.com>
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_PROTOCOL=smtps
MAIL_ENABLED=true

# --- Push ---------------------------------------------------------------------
# On, unlike development. Nothing reaches a phone with this false.
PUSH_ENABLED=true

# --- CORS ---------------------------------------------------------------------
# The APK is a native app and sends no Origin header, so this only matters if you
# open the web build. Left permissive for the demo period.
CORS_ALLOWED_ORIGIN_PATTERNS=*
