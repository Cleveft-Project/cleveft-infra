# Copy to .env and fill in. Never commit the real .env.
DB_NAME=cleveft
DB_USERNAME=cleveft_user
DB_PASSWORD=cleveft_pass
DB_EXPOSED_PORT=5433

# Must be at least 32 bytes. The gateway and the auth service must share this
# exact value or every authenticated request will 401.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes

# Google GenAI key used for speech-to-text, embeddings and RAG synthesis.
GOOGLE_API_KEY=

# Model allocation. Every Gemini model has its own free-tier quota pool, so
# these decide what breaks first when you hit a limit. Leave blank to use the
# spread set in docker-compose.yml:
#
#   GEMINI_STT_MODEL    flash-lite  speech-to-text (the heaviest single call)
#   GEMINI_NOTES_MODEL  flash       turning a transcript into structured notes
#   GEMINI_CHAT_MODEL   flash       answering questions about your lectures
#   GEMINI_MODEL        flash-lite  quiz and exam-summary generation
#
# Set any of them to gemini-3.5-flash to go back to the non-lite model, once
# its free-tier capacity issues (ongoing since mid-June 2026) have cleared up.
GEMINI_STT_MODEL=
GEMINI_NOTES_MODEL=
GEMINI_CHAT_MODEL=
GEMINI_MODEL=

# Comma-separated origin patterns the gateway will accept. "*" is fine for local
# development; pin it to real origins before deploying.
CORS_ALLOWED_ORIGIN_PATTERNS=*
